{
  "rest": {
    "RestGenerator": {
      "name": "acme-rag-unguarded",
      "uri": "http://localhost:8001/ask",
      "method": "post",
      "headers": {
        "Content-Type": "application/json"
      },
      "req_template_json_object": {
        "question": "$INPUT"
      },
      "response_json": true,
      "response_json_field": "answer",
      "request_timeout": 120,
      "ratelimit_codes": [429, 503]
    }
  }
}
